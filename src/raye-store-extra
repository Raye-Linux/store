#!/usr/bin/python3 -I
# SPDX-License-Identifier: GPL-3.0-or-later
"""Installs or removes an app Raye offers itself, from extras.json.

    raye-store-extra install <package>
    raye-store-extra remove <package>

Run as root through pkexec by Raye Store. Only packages listed in the
root-owned catalog can be touched; the download must come over https
and match the SHA-256 written in the catalog, or nothing is installed.

For the Store's progress bar it prints, one a line:
    phase downloading|installing|removing
    progress <0-100>          (when the size is known)
    bytes <done> <total>      (total 0 when not known)
While it downloads, a line "cancel" on stdin stops it (exit code 3).
"""

import hashlib
import json
import os
import re
import select
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request

CATALOG = "/usr/share/raye-store/extras.json"
CACHE = "/var/cache/raye-store"
PACKAGE = re.compile(r"^[a-z0-9][a-z0-9+.-]+$")
SHA256 = re.compile(r"^[0-9a-f]{64}$")
MAX_SIZE = 512 * 1024 * 1024


def entry_for(package, path=CATALOG):
    with open(path) as f:
        apps = json.load(f).get("apps", [])
    for app in apps:
        if app.get("package") == package:
            if not str(app.get("url", "")).startswith("https://"):
                raise ValueError("the catalog entry has no https address")
            if not SHA256.match(str(app.get("sha256", ""))):
                raise ValueError("the catalog entry has no SHA-256")
            return app
    raise LookupError(f"{package} is not offered by Raye")


class Cancelled(Exception):
    pass


class CancelWatch:
    """Looks, without waiting, for a "cancel" line on a file descriptor."""

    def __init__(self, fd):
        self.fd = fd
        self.buffer = b""

    def requested(self):
        if self.fd is None:
            return False
        try:
            ready, _, _ = select.select([self.fd], [], [], 0)
            if not ready:
                return False
            chunk = os.read(self.fd, 256)
        except (OSError, ValueError):
            self.fd = None
            return False
        if not chunk:
            # the Store went away: finish what was started
            self.fd = None
            return False
        self.buffer = (self.buffer + chunk)[-1024:]
        return b"cancel\n" in self.buffer


def stdin_fd():
    try:
        return sys.stdin.fileno()
    except (AttributeError, OSError, ValueError):
        return None


def say(line):
    print(line, flush=True)


class HttpsOnly(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if not newurl.startswith("https://"):
            raise urllib.error.URLError("redirect away from https refused")
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def announced_size(resp):
    try:
        size = int(getattr(resp, "headers", {}).get("Content-Length", 0))
    except (TypeError, ValueError):
        return 0
    return size if size > 0 else 0


def download(url, expected, dest_dir=CACHE, opener=None, report=None, watch=None):
    os.makedirs(dest_dir, mode=0o755, exist_ok=True)
    opener = opener or urllib.request.build_opener(HttpsOnly)
    report = report or (lambda line: None)
    digest = hashlib.sha256()
    fd, tmp = tempfile.mkstemp(dir=dest_dir, suffix=".deb")
    try:
        size = 0
        shown = -1     # last percent printed
        reported = 0   # bytes in the last "bytes" line
        with os.fdopen(fd, "wb") as out, opener.open(url, timeout=60) as resp:
            total = announced_size(resp)
            if total > MAX_SIZE:
                raise ValueError("download too large")
            while chunk := resp.read(1 << 16):
                if watch is not None and watch.requested():
                    raise Cancelled()
                size += len(chunk)
                if size > MAX_SIZE:
                    raise ValueError("download too large")
                digest.update(chunk)
                out.write(chunk)
                known = total if total >= size else 0
                percent = size * 100 // known if known else -1
                # a line a percent, or a megabyte when the size is not known
                due = percent != shown if known else size - reported >= 1 << 20
                if due:
                    report(f"bytes {size} {known}")
                    reported = size
                    if known:
                        shown = percent
                        report(f"progress {percent}")
            if size != reported:
                report(f"bytes {size} {total if total >= size else 0}")
        if digest.hexdigest() != expected:
            raise ValueError("the download does not match the SHA-256 in the catalog")
        os.chmod(tmp, 0o644)
        return tmp
    except BaseException:
        os.unlink(tmp)
        raise


def main(argv):
    if len(argv) != 3 or argv[1] not in ("install", "remove") or not PACKAGE.match(argv[2]):
        print("usage: raye-store-extra install|remove <package>", file=sys.stderr)
        return 2
    verb, package = argv[1], argv[2]
    try:
        app = entry_for(package)
    except (OSError, ValueError, LookupError) as e:
        print(f"raye-store-extra: {e}", file=sys.stderr)
        return 1
    env = dict(os.environ, DEBIAN_FRONTEND="noninteractive")
    if verb == "remove":
        say("phase removing")
        return subprocess.run(["apt-get", "remove", "-y", "-q", package], env=env, stdin=subprocess.DEVNULL).returncode
    say("phase downloading")
    try:
        deb = download(app["url"], app["sha256"], report=say, watch=CancelWatch(stdin_fd()))
    except Cancelled:
        print("raye-store-extra: cancelled", file=sys.stderr)
        return 3
    except (OSError, ValueError) as e:
        print(f"raye-store-extra: {e}", file=sys.stderr)
        return 1
    say("phase installing")
    try:
        return install_deb(deb, env)
    finally:
        os.unlink(deb)


def install_deb(deb, env, run=subprocess.run):
    """Installs the checked package, then empties apt's download cache:
    the packages apt fetched for it are not kept on the disk. apt-get
    clean waits for apt's lock, so it never takes what another running
    install still needs."""
    try:
        return run(["apt-get", "install", "-y", "-q", deb], env=env, stdin=subprocess.DEVNULL).returncode
    finally:
        run(["apt-get", "clean"], env=env, stdin=subprocess.DEVNULL)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
